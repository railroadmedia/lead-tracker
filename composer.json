{
  "name": "railroad/lead-tracker",
  "type": "library",
  "description": "Tracks email form submissions and marketing data for visitor origins.",
  "keywords": [
    "tracker",
    "lead"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Caleb Favor",
      "email": "caleb@musora.com",
      "role": "Chief Technology Officer"
    }
  ],
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "doctrine/dbal": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "autoload": {
    "psr-4": {
      "Railroad\\LeadTracker\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Railroad\\LeadTracker\\Tests\\": "tests/"
    }
  }
}
